---
import type { CollectionEntry } from "astro:content";

interface Props {
	post: CollectionEntry<"blog">;
}

const {
	id,
	data: { pubDate, categories },
} = Astro.props.post;
---

{(pubDate || categories) && (
		<p class="flex flex-wrap gap-4 text-xs text-gray-300" style={`view-transition-name: ${id}-meta`}>
			{pubDate && (
				<span class="inline-flex gap-1 items-center">
					<time datetime={pubDate.toISOString()}>
						{pubDate.toLocaleDateString("en-US", { timeZone: "UTC" })}
					</time>
				</span>
			)}
			{categories && (
				<span class="inline-flex gap-1 items-center">
					{categories.join(", ")}
				</span>
			)}
		</p>
	)}
