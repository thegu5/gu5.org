---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import PostMeta from "../components/PostMeta.astro";

interface Props {
	post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const {
	id,
	data: { title, description = "", image, imageAlt = "" },
} = post;
---

<Layout title={title ?? "Blog post"} {description}>
	{image && <img src={image} alt={imageAlt} />}
	<div class="prose dark:prose-invert max-w-full wrap-break-word">
		<h1 style={`view-transition-name: ${id}`}>{title}</h1>
		<PostMeta {post} />
		<slot />
	</div>
</Layout>
